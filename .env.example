# Firebase web config. Copy to .env and fill from
# Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup.
#
# These values are public by design: they identify the project, they do not grant
# access. Access is controlled by firestore.rules plus the Authorized domains
# list in Firebase Auth. Never put a service account key here.
#
# Leave this file empty to run the app without accounts (base catalog only).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
