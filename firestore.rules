rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every document lives under users/{uid}, so one rule covers the whole app:
    // a signed-in user reads and writes only their own subtree, and there is no
    // shared writable space at all.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
